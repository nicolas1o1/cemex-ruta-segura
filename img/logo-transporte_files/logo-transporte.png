    .chatgptChatView.cc440d50ba-split-enabled .cc440d50ba-express-entrypoint-button:hover .cc440d50ba-express-entrypoint-button-icon-img--default,
    .chatgptChatView.cc440d50ba-split-enabled .cc440d50ba-express-entrypoint-button.cc440d50ba-dropdown-hover .cc440d50ba-express-entrypoint-button-icon-img--default {
