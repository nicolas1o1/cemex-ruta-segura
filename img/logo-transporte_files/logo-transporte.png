    /* ChatGPT Chat View in dropdown experiment: dark icon by default, red icon on hover */
    .chatgptChatView.cc440d50ba-split-enabled .cc440d50ba-express-entrypoint-button-icon-img--default {
      display: inline-block;
    }

    .chatgptChatView.cc440d50ba-split-enabled .cc440d50ba-express-entrypoint-button-icon-img--hover {
