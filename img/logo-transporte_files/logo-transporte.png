    /* Split button (three-dot menu) styles */
    .cc440d50ba-express-three-dot-trigger {
        display: flex;
        align-items: center;
        justify-content: center;
        /* collapses to 0; animates to 24×24 rounded square + 4px right gap from pill boundary */
        width: 0;
        height: 24px;
        flex-shrink: 0;
        align-self: center;
        margin-right: 0;
        border-radius: 7px;
        box-sizing: border-box;
        cursor: pointer;
        /* Reset host-page button styles (ChatGPT targets role=button/tabindex) */
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        background-color: transparent;
        -webkit-appearance: none;
        appearance: none;
        color: inherit;
        overflow: hidden;
        opacity: 0;
        transition: width 0.2s ease-out, margin-right 0.2s ease-out, opacity 0.2s ease-out;
    }
    .cc440d50ba-express-three-dot-trigger svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }
    /* Override ChatGPT's focus ring on the trigger at all focus states */
    .cc440d50ba-express-three-dot-trigger:focus,
    .cc440d50ba-express-three-dot-trigger:focus-visible,
    .cc440d50ba-express-three-dot-trigger:focus-within {
        outline: none !important;
        border: none !important;
        box-shadow: none !important;
    }
    /* Show trigger on parent hover: 24×24 square with 4px gap from pill right edge */
    .cc440d50ba-express-entrypoint-button:hover .cc440d50ba-express-three-dot-trigger.cc440d50ba-split-active {
        width: 24px;
        margin-right: 8px;
        background-color: #f3f3f3;
        opacity: 1;
        transition: width 0.3s ease, margin-right 0.3s ease, opacity 0.3s ease;
    }
    /* Active/selected (#d5d5d5) when menu is open */
    .cc440d50ba-express-entrypoint-button.cc440d50ba-menu-open .cc440d50ba-express-three-dot-trigger.cc440d50ba-split-active {
        width: 24px;
        margin-right: 8px;
        background-color: #d5d5d5;
        opacity: 1;
    }
    /* Animate padding-right in sync with trigger: ease-out on collapse so button shrinks immediately on hover-out */
    .cc440d50ba-split-enabled .cc440d50ba-express-entrypoint-button .cc440d50ba-express-entrypoint-button-text {
        transition: padding-right 0.2s ease-out;
    }
    /* Reduce text right-padding only when hamburger is visible (hover/menu-open); ease on expand for gentle grow */
    .cc440d50ba-split-enabled .cc440d50ba-express-entrypoint-button:hover .cc440d50ba-express-entrypoint-button-text,
    .cc440d50ba-split-enabled .cc440d50ba-express-entrypoint-button.cc440d50ba-menu-open .cc440d50ba-express-entrypoint-button-text {
